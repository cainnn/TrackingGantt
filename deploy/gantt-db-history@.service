[Unit]
Description=Gantt PostgreSQL historical snapshot (%i)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
EnvironmentFile=/etc/gantt-db-history.env
ExecStart=/usr/bin/python3 /usr/local/lib/gantt-db-history/db-history-backup.py %i
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal

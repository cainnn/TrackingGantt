{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": ".test-dist",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*.ts",
    "lib/clientTime.ts",
    "lib/statusDatePolicy.ts",
    "lib/projectProgress.ts",
    "lib/ai/chatPolicy.ts",
    "lib/ai/summaryPolicy.ts",
    "lib/scheduling.ts",
    "lib/client/excelImport.ts",
    "types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}

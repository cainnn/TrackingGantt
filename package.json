{
  "name": "gantt-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "db:init": "node scripts/init-db.js",
    "source-pdf": "node scripts/generate-source-pdf.js",
    "doc-pdf": "node scripts/generate-doc-pdf.js",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "deploy:fast": "SKIP_BACKUP=1 SKIP_MIGRATE=1 bash scripts/deploy-vps.sh",
    "deploy:local": "LOCAL_BUILD=1 bash scripts/deploy-vps.sh",
    "sync:db": "bash scripts/sync-db-to-vps.sh",
    "sync:db:data": "bash scripts/sync-db-to-vps.sh --data-only"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "next": "16.1.6",
    "openai": "^6.33.0",
    "pg": "^8.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-redux": "^9.2.0",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "puppeteer": "^24.39.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
